FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Note: "turbulenceProperties" est le nom correct pour OpenFOAM ESI (v2012+).
// Ne pas confondre avec "momentumTransport" utilisé par OpenFOAM.org.

simulationType  RAS;

RAS
{
    RASModel    kOmegaSST;
    turbulence  on;
    printCoeffs on;
}

