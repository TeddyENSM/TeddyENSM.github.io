FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (2.06 0 0);

boundaryField
{
    inlet
    {
        type            freestreamVelocity;
        freestreamValue uniform (2.06 0 0);
    }
    outlet
    {
        type            freestreamVelocity;
        freestreamValue uniform (2.06 0 0);
    }
    profile
    {
        type            noSlip;
    }
    top
    {
        type            freestreamVelocity;
        freestreamValue uniform (2.06 0 0);
    }
    bottom
    {
        type            freestreamVelocity;
        freestreamValue uniform (2.06 0 0);
    }
    frontAndBack
    {
        type            empty;
    }
}
