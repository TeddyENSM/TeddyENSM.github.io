FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0.011;

boundaryField
{
    inlet
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.05;
        value           uniform 0.011;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.011;
        value           uniform 0.011;
    }
    profile
    {
        type            kqRWallFunction;
        value           uniform 0.011;
    }
    top
    {
        type            inletOutlet;
        inletValue      uniform 0.011;
        value           uniform 0.011;
    }
    bottom
    {
        type            inletOutlet;
        inletValue      uniform 0.011;
        value           uniform 0.011;
    }
    frontAndBack
    {
        type            empty;
    }
}
