FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 30;

boundaryField
{
    inlet
    {
        type            turbulentMixingLengthDissipationRateInlet;
        mixingLength    0.07;
        value           uniform 30;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 30;
        value           uniform 30;
    }
    profile
    {
        type            omegaWallFunction;
        value           uniform 30;
    }
    top
    {
        type            inletOutlet;
        inletValue      uniform 30;
        value           uniform 30;
    }
    bottom
    {
        type            inletOutlet;
        inletValue      uniform 30;
        value           uniform 30;
    }
    frontAndBack
    {
        type            empty;
    }
}
